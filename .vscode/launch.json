{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "MVBench - OVIS - fps:2:4:96 (test)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/vlm_MVBench.py",
            "console": "integratedTerminal",
            "args": ["--model", "ovis", "--mode", "fps:2:4:96", "--test", "--limit", "3"]
        },
        {
            "name": "VideoMME - OVIS - fps:2:4:96 (test)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/vlm_VideoMME.py",
            "console": "integratedTerminal",
            "args": ["--model", "ovis", "--mode", "fps:2:4:96", "--test", "--video_dir", "./data/VideoMME/data"]
        },
        {
            "name": "MVBench v2 - OVIS - fps:2:4:96 (test)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/vlm_MVBench_v2.py",
            "console": "integratedTerminal",
            "args": ["--model", "ovis", "--mode", "fps:2:4:96", "--test"]
        },
        {
            "name": "Extract Frame Indices - MVBench - center",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/extract_frame_indices.py",
            "console": "integratedTerminal",
            "args": ["--benchmark", "mvbench", "--mode", "center", "--limit", "3"]
        },
        {
            "name": "Extract Frame Indices - VideoMME - center",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/extract_frame_indices.py",
            "console": "integratedTerminal",
            "args": ["--benchmark", "videomme", "--mode", "center", "--limit", "3"]
        }
    ]
}